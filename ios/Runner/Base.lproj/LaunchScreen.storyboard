<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="12121" systemVersion="16G29" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12089"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <layoutGuides>
                        <viewControllerLayoutGuide type="top" id="Ydg-fD-yQy"/>
                        <viewControllerLayoutGuide type="bottom" id="xbc-2k-c8Z"/>
                    </layoutGuides>
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Brat Green Container Box (app icon style) -->
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="brat-box-01">
                                <autoresizingMask key="autoresizingMask"/>
                                <subviews>
                                    <!-- "brat" label inside the green box -->
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="brat" textAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="brat-label-01">
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="34"/>
                                        <color key="textColor" red="0.0" green="0.0" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <nil key="highlightedColor"/>
                                        <constraints>
                                            <constraint firstAttribute="width" constant="100" id="lbl-w"/>
                                            <constraint firstAttribute="height" constant="50" id="lbl-h"/>
                                        </constraints>
                                    </label>
                                </subviews>
                                <!-- Brat lime green color #8ACE00 -->
                                <color key="backgroundColor" red="0.541" green="0.808" blue="0.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <layer key="layer" cornerRadius="22"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="100" id="box-w"/>
                                    <constraint firstAttribute="height" constant="100" id="box-h"/>
                                    <constraint firstItem="brat-label-01" firstAttribute="centerX" secondItem="brat-box-01" secondAttribute="centerX" id="label-cx"/>
                                    <constraint firstItem="brat-label-01" firstAttribute="centerY" secondItem="brat-box-01" secondAttribute="centerY" id="label-cy"/>
                                </constraints>
                            </view>

                            <!-- "Bratify" title below the box -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Bratify" textAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="title-label-01">
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="28"/>
                                <color key="textColor" red="1.0" green="1.0" blue="1.0" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>

                            <!-- Loading indicator at bottom -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Aesthetic Meme &amp; Text Studio" textAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="sub-label-01">
                                <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                <color key="textColor" red="1.0" green="1.0" blue="1.0" alpha="0.55" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>

                        <!-- Dark background: #0D0D11 -->
                        <color key="backgroundColor" red="0.051" green="0.051" blue="0.067" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>

                        <constraints>
                            <!-- Green box centered -->
                            <constraint firstItem="brat-box-01" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="box-cx"/>
                            <constraint firstItem="brat-box-01" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-60" id="box-cy"/>

                            <!-- Title 20pt below box -->
                            <constraint firstItem="title-label-01" firstAttribute="top" secondItem="brat-box-01" secondAttribute="bottom" constant="20" id="title-top"/>
                            <constraint firstItem="title-label-01" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="title-cx"/>

                            <!-- Subtitle 8pt below title -->
                            <constraint firstItem="sub-label-01" firstAttribute="top" secondItem="title-label-01" secondAttribute="bottom" constant="8" id="sub-top"/>
                            <constraint firstItem="sub-label-01" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="sub-cx"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
</document>
